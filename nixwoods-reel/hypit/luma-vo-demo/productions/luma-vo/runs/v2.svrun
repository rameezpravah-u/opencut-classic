<?svml using="@hypit/markup/run@1"?>
<svrun version="1">
  <author source="../reel-v2.svml"/>
  <target output="final.video"/>
  <!-- Hook swap: only the on-screen hook line changed. Keep v1's measured VO, its word
       alignment and the prepared footage; only the composition is rendered again. -->
  <build-record id="v1-vo" build="bld_20261025T083529171Z_3F4E160111" output="vo-media.media"/>
  <build-record id="v1-vo-domain" build="bld_20261025T083529171Z_3F4E160111" output="vo-media.domain"/>
  <build-record id="v1-vo-extent" build="bld_20261025T083529171Z_3F4E160111" output="vo-media.extent"/>
  <build-record id="v1-alignment" build="bld_20261025T083529171Z_3F4E160111" output="vo-alignment.alignment"/>
  <build-record id="v1-shots" build="bld_20261025T083529171Z_3F4E160111" output="shots.media"/>
  <satisfy output="vo-media.media" candidate="v1-vo"/>
  <satisfy output="vo-media.domain" candidate="v1-vo-domain"/>
  <satisfy output="vo-media.extent" candidate="v1-vo-extent"/>
  <satisfy output="vo-alignment.alignment" candidate="v1-alignment"/>
  <satisfy output="shots.media" candidate="v1-shots"/>
</svrun>
